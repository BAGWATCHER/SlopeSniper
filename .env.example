JUPITER_API_KEY=

# Optional: custom Solana RPC endpoint.
SOLANA_RPC_URL=

# Optional: local API wrapper auth key if you run slopesniper-api.
SLOPESNIPER_API_KEY=

# Advanced only: private key override. Prefer `slopesniper setup` for normal use.
# SOLANA_PRIVATE_KEY=
